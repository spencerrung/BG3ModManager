<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DivinityModManager.Views.MainWindow"
        Title="BG3 Mod Manager"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="16" Background="#1E1E1E" BorderThickness="0,0,0,1" BorderBrush="#3E3E3E">
            <TextBlock Text="Baldur's Gate 3 Mod Manager - Avalonia Migration (Alpha)"
                       FontSize="18"
                       Foreground="White"
                       FontWeight="Bold" />
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Padding="16">
            <TextBlock Text="Main content area - Ready for porting UI components"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Padding="16" Background="#2D2D2D" BorderThickness="0,1,0,0" BorderBrush="#3E3E3E">
            <TextBlock Text="Status: Application loaded successfully"
                       Foreground="#B0B0B0"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
